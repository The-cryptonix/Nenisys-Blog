{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "functions": {
    "api/render.ts": { "includeFiles": "dist/index.html" }
  },
  "rewrites": [
    { "source": "/blog/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/sitemap-blog.xml", "destination": "/api/render?sitemap=1" },
    { "source": "/blog", "destination": "/api/render" },
    { "source": "/blog/:slug", "destination": "/api/render?slug=:slug" }
  ],
  "headers": [
    {
      "source": "/blog/:path*",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: data:; media-src 'self' https:; font-src 'self'; connect-src 'self' https://api.nenisys.shop; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/blog/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
